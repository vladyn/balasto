---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.rewrite("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base
	title={`Posts tagged "${term.label}"`}
	description={`Posts tagged ${term.label}`}
>
	<header class="page-header">
		<span class="page-eyebrow">Tag Archive</span>
		<h1 class="page-title">#{term.label}</h1>
		<p class="page-lead">All articles tagged under #{term.label}.</p>
	</header>

	{
		posts.length === 0 ? (
			<div class="empty-state">
				<p class="empty-message">No posts found with this tag.</p>
				<a href="/posts" class="btn btn-outline">&larr; Back to all posts</a>
			</div>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-list-item">
						{post.data.featured_image && (
							<a
								href={`/posts/${post.id}`}
								class="post-list-thumb"
								{...post.edit.featured_image}
							>
								<Image image={post.data.featured_image} />
							</a>
						)}
						<div class="post-list-content">
							<div class="meta-group">
								<span class="badge badge-neutral">#{term.label}</span>
								{post.data.publishedAt && (
									<time datetime={post.data.publishedAt.toISOString()}>
										{post.data.publishedAt.toLocaleDateString("en-US", {
											year: "numeric",
											month: "short",
											day: "numeric",
										})}
									</time>
								)}
							</div>

							<h2 class="post-list-title">
								<a href={`/posts/${post.id}`} {...post.edit.title}>
									{post.data.title}
								</a>
							</h2>

							{post.data.excerpt && (
								<p class="post-list-excerpt" {...post.edit.excerpt}>
									{post.data.excerpt}
								</p>
							)}
						</div>
					</li>
				))}
			</ul>
		)
	}

	<nav class="pagination-nav" aria-label="Pagination">
		{cursor ? (
			<a href={`/tag/${term.slug}`} class="btn btn-outline">&larr; First page</a>
		) : (
			<span />
		)}
		{
			nextCursor && (
				<a
					href={`/tag/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`}
					class="btn btn-primary"
				>
					Next page &rarr;
				</a>
			)
		}
	</nav>
</Base>

<style>
	.page-header {
		margin-bottom: var(--space-10);
		padding-bottom: var(--space-8);
		border-bottom: 2px solid var(--color-primary);
	}

	.page-eyebrow {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-accent);
		margin-bottom: var(--space-2);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		color: var(--color-primary);
		letter-spacing: var(--tracking-tighter);
		margin-bottom: var(--space-2);
	}

	.page-lead {
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		margin-bottom: 0;
	}

	.empty-state {
		text-align: center;
		padding: var(--space-16) var(--space-4);
		background-color: var(--color-surface);
		border: 1px dashed var(--color-border-strong);
		border-radius: var(--radius-md);
	}

	.empty-message {
		font-size: var(--font-size-lg);
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}
</style>
