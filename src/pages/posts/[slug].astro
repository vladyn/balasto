---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

// SEO meta from content fields
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

// Taxonomy terms are already hydrated onto the entry by getEmDashEntry.
const tags = post.data.terms?.tag ?? [];
const categories = post.data.terms?.category ?? [];
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="reading-container">
		<nav class="back-nav">
			<a href="/posts" class="back-link">&larr; Back to all posts</a>
		</nav>

		<article class="article-detail">
			<header class="article-header">
				<div class="article-header-meta">
					{
						categories.map((c) => (
							<a href={`/category/${c.slug}`} class="badge badge-accent">
								{c.label}
							</a>
						))
					}
					{
						post.data.publishedAt && (
							<time
								datetime={post.data.publishedAt.toISOString()}
								class="post-detail-date"
							>
								{post.data.publishedAt.toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</time>
						)
					}
				</div>

				<h1 class="article-title" {...post.edit.title}>
					{post.data.title}
				</h1>

				{
					post.data.excerpt && (
						<p class="article-lead" {...post.edit.excerpt}>
							{post.data.excerpt}
						</p>
					)
				}

				{
					post.data.featured_image && (
						<div class="article-featured-image" {...post.edit.featured_image}>
							<Image image={post.data.featured_image} />
						</div>
					)
				}
			</header>

			<div class="prose">
				<PortableText value={post.data.content} />
			</div>

			<footer class="article-footer">
				{
					tags.length > 0 && (
						<div class="article-tags-wrap">
							<span class="tags-label">Tagged in:</span>
							<div class="tag-cloud">
								{tags.map((t) => (
									<a href={`/tag/${t.slug}`} class="badge badge-neutral">
										#{t.label}
									</a>
								))}
							</div>
						</div>
					)
				}

				<div class="article-navigation-bottom">
					<a href="/posts" class="btn btn-outline">&larr; Return to Posts</a>
					<a href="#" class="btn btn-outline back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">
						Top &uarr;
					</a>
				</div>
			</footer>
		</article>

		<aside class="article-widgets">
			<WidgetArea name="sidebar" />
		</aside>
	</div>
</Base>

<style>
	.back-nav {
		margin-bottom: var(--space-6);
	}

	.back-link {
		font-family: var(--font-display);
		font-size: var(--font-size-sm);
		font-weight: var(--font-weight-semibold);
		color: var(--color-primary);
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.article-lead {
		font-size: var(--font-size-xl);
		color: var(--color-text-muted);
		line-height: var(--line-height-normal);
		margin-bottom: var(--space-6);
		font-weight: var(--font-weight-medium);
	}

	.post-detail-date {
		font-size: var(--font-size-sm);
		color: var(--color-text-muted);
		font-family: var(--font-display);
	}

	.article-tags-wrap {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.tags-label {
		font-family: var(--font-display);
		font-size: var(--font-size-xs);
		font-weight: var(--font-weight-bold);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-text-muted);
	}

	.article-navigation-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: var(--space-4);
	}

	.article-widgets {
		margin-top: var(--space-12);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border);
	}
</style>
